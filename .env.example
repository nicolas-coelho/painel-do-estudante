# Configurações do Firebase para o Painel do Estudante
# Obtenha estas credenciais no Firebase Console:
# https://console.firebase.google.com/ -> Seu Projeto -> Configurações do Projeto (ícone da engrenagem) -> Seus aplicativos -> Aplicativo da Web (SDK setup and configuration)

VITE_FIREBASE_API_KEY=sua_api_key_aqui
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto-id
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=seu_sender_id
VITE_FIREBASE_APP_ID=seu_app_id

# Whitelist de e-mails autorizados a acessar o painel (separados por vírgula)
# Deixe em branco se desejar permitir qualquer conta autenticada
VITE_ALLOWED_EMAILS=seu_email@gmail.com

# ============================================================================
# Variáveis Server-Side (Vercel Environment Variables — nunca expostas no client)
# ============================================================================
# Chave do Google Gemini (Google AI Studio) para Consultoria IA na Página Inicial e no E-mail Diário
GEMINI_API_KEY=sua_gemini_api_key_aqui
# Modelo opcional (padrão: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Envio de e-mail diário (/api/daily-digest) via Resend
RESEND_API_KEY=re_sua_chave_resend_aqui
NOTIFICATION_EMAIL=seu_email@gmail.com

# Conta de serviço Firebase (JSON ou Base64) para leitura autenticada no Cron diário e MCP
FIREBASE_SERVICE_ACCOUNT=
