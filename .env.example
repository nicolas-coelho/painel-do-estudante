# Configurações do Firebase para o Painel do Estudante
# Obtenha estas credenciais no Firebase Console:
# https://console.firebase.google.com/ -> Seu Projeto -> Configurações do Projeto (ícone da engrenagem) -> Seus aplicativos -> Aplicativo da Web (SDK setup and configuration)

VITE_FIREBASE_API_KEY=sua_api_key_aqui
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto-id
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=seu_sender_id
VITE_FIREBASE_APP_ID=seu_app_id
